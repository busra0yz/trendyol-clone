# --- SUNUCU AYARLARI ---
PORT=                           # Uygulamanın çalışacağı port numarası. Genellikle 3000, 5000 veya 8080 kullanılır.
NODE_ENV=                # Uygulamanın çalıştığı ortam (geliştirme aşaması olduğu için 'development'). Yayına alırken 'production' yapılır.

# --- VERİTABANI (MySQL) AYARLARI ---
DB_HOST=                   # Veritabanının çalıştığı sunucu adresi (kendi bilgisayarın olduğu için localhost).
DB_PORT=                        # MySQL'in varsayılan çalışma portu.
DB_USER=                        # MySQL veritabanı kullanıcı adı. XAMPP/WAMP stili yerel kurulumlarda genelde 'root'tur.
DB_PASSWORD=                  # MySQL veritabanı şifren. (Eğer kurulumda şifre belirlemediysen burayı boş bırakabilirsin).
DB_NAME=               # Bağlanmak ve işlem yapmak istediğin veritabanının adı.

# --- GÜVENLİK (JSON WEB TOKEN) AYARLARI ---
JWT_SECRET=                  # Kullanıcı giriş (token) şifrelemesi için kullanılan çok gizli güvenlik anahtarı.
JWT_EXPIRES_IN=                  # Kullanıcı giriş yaptıktan sonra token'ın geçerlilik süresi (7d = 7 gün).
